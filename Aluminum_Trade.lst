G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  *current regions: EU-27, Open-Destinations (OpD), Closed-Destinations(RoW)
   2  set r /EU, OpD, RoW/;
   3  set al /primary, scrap/;
   4   
   5   
   6  *prices USD/metric ton , qty =  metric tons, currently total aluminum (primary + scrap)
   7  parameter
   8  ****NUMBERS ARE PRETTY RANDOM NEED TO SEARCH FOR BETTER DATA**************
   9  *!!!!!!!!!!!!!!!!Prices for Importers need to be higher than the respective exporters!!!!!!!!!!!!!!!!
  10  pbar(r,al) /EU.primary 2768, EU.scrap 1745, OpD.primary 2784, OpD.scrap 1707, RoW.primary 2419, RoW.scrap 2020/,
  11  *qty supplied aluminum EU, Open-Destinations, and Closed-Destinations
  12  qbar_s(r,al) /EU.primary 1200000, EU.scrap 5586616, OpD.primary 7898000, OpD.scrap 6113480, RoW.primary 63702000, RoW.scrap 29999904/,
  13  *qty demanded aluminum EU, Open-Destinations, and Closed-Destinations
  14  qbar_d(r,al) /EU.primary 6000000, EU.scrap 5000000, OpD.primary 8501419, OpD.scrap 4374909, RoW.primary 58298581, RoW.scrap 32325091/,
  15   
  16  *elasticity of supply
  17  e_s(r,al) /EU.primary 0.4, EU.scrap 0.21, OpD.primary 0.4, OpD.scrap 0.21, RoW.primary 0.4, RoW.scrap 0.21/,
  18  *elasticity of demand
  19  e_d(r,al) /EU.primary -0.2, EU.scrap -0.5, OpD.primary -0.2, OpD.scrap -0.5, RoW.primary -0.2, RoW.scrap -0.5/;
  20   
  21  *currently based off of Pd = a + b*Qd, Ps = c + d*Qs, where a,b,c,d are parameters
  22  parameter a(r,al),b(r,al),c(r,al),d(r,al);
  23   
  24  b(r,al) = pbar(r,al) / (e_d(r,al) * qbar_d(r,al));
  25  a(r,al) = pbar(r,al) - b(r,al) * qbar_d(r,al);
  26  d(r,al) = pbar(r,al) / (e_s(r,al) * qbar_s(r,al));
  27  c(r,al) = pbar(r,al) - d(r,al) * qbar_s(r,al);
  28   
  29  alias(r,rr);
  30  *t will essentially be the cost of transportation
  31  parameter t(r,rr,al);
  32   
  33   
  34  t(r,rr,al) = abs(pbar(rr,al) - pbar(r,al)) ;
  35   
  36  *varibales
  37  positive variable Qd(r,al), Qs(r,al);
  38  **!!!!needs to be for region too!!!!
  39  * variable X(r,al) "exports";
  40  variable W "total welfare";
  41   
  42  *market clearing conditions
  43  equation objfn;
  44   
  45   
  46  alias(r,rr) ;
  47  positive variable ship(r,rr,al) ;
  48   
  49   
  50  objfn.. W =e=
  51     sum((r,al), a(r,al) * Qd(r,al) + b(r,al) * Qd(r,al) *Qd(r,al) /2
  52     - c(r,al) * Qs(r,al) - d(r,al) *Qs(r,al) * Qs(r,al) / 2 )
  53     - sum((r,rr,al), t(r,rr,al) * ship(r,rr,al));
  54   
  55  equation market_clearing_r(r,al) ;
  56  market_clearing_r(r,al)..  Qd(r,al) + sum(rr$(not sameas(r,rr)), ship(r,rr,al)) =e= Qs(r,al) + sum(rr$(not sameas(r,rr)), ship(rr,r,al));
  57   
  58  model simple /all/;
  59   
  60  solve simple using QCP maximizing W;
  61   
  62  *$exit
  63   
  64  parameter rep;
  65  parameter shiprep(*,r,rr,al) "shipments by route";
  66   
  67  *rep("BAU", "Qd", r, al) = Qd.l(r,al);
  68  *rep("BAU", "Qs", r, al) = Qs.l(r,al);
  69  *rep("BAU", "P", r, al)  = market_clearing_r.m(r,al);
  70  *shiprep("BAU", r, rr, al) = ship.l(r,rr,al);
  71   
  72  *execute_unload "simple.gdx";
  73   
  74  ****************Scrap ban from eu to closed destinations (row)****************
  75  ship.fx('EU','RoW','scrap') = 0;
  76   
  77  solve simple using QCP maximizing W;
  78   
  79  rep("BAN", "Qd", r, al) = Qd.l(r,al);
  80  rep("BAN", "Qs", r, al) = Qs.l(r,al);
  81  rep("BAN", "P", r, al)  = market_clearing_r.m(r,al);
  82  shiprep("BAN", r, rr, al) = ship.l(r,rr,al);
  83   
  84  execute_unload "simple.gdx";
  85   
  86   


