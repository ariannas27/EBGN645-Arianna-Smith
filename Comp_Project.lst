C o m p i l a t i o n


   1  *!!!!!!!!!EU EXPORT BAN!!!!!!
   2  *current sets: regions (US, EU, OECD (-EU countries in OECD and US), Non-OECD(essentially row now?)), aluminum type (primary or secondary)
   3  **may further complicate the regions set, Certainly add canada next (next situation is US Tariffs)
   4  *will have to add time dimension, this is another set?
   5  *****NEXT STEPS: FIND more ACCURATE DATA, ADD CANADA, US TARIFFS******
   6   
   7  set r /USA, EU, OECD, N_OECD/;
   8  set al /primary, secondary/;
   9   
  10  *parameters = essentially cost curves, !!!!!!!!FIND BETTER NUMBERS!!!!! - currently using rough estimated numbers from AI
  11  *prices USD/metric ton , qty = metric tons
  12  parameter
  13  *!!!!!!!!!!!!!!!!Prices for Importers need to be higher than the respective exporters!!!!!!!!!!!!!!!!
  14  pbar(r,al) /USA.primary 5500, USA.secondary 3100, EU.primary 3700, EU.secondary 3300, OECD.primary 3550, OECD.secondary 3100, N_OECD.primary 3150, N_OECD.secondary 3500/,
  15  *qty supplied aluminum USA and ROW
  16  qbar_s(r,al) /USA.primary 700000, USA.secondary 5000000, EU.primary 3000000, EU.secondary 6900000, OECD.primary 7300000, OECD.secondary 5300000, N_OECD.primary 62000000, N_OECD.secondary 12800000/,
  17  *qty demanded aluminum USA and ROW
  18  qbar_d(r,al) /USA.primary 3500000, USA.secondary 3300000, EU.primary 7500000, EU.secondary 6200000, OECD.primary 4500000, OECD.secondary 4500000, N_OECD.primary 57500000, N_OECD.secondary 16000000/,
  19  **!!!!!change for at least primary and secondary for now!!!!
  20  *elasticity of supply
  21  e_s(r,al) /USA.primary 0.4, USA.secondary 0.2, EU.primary 0.4, EU.secondary 0.2, OECD.primary 0.4, OECD.secondary 0.2, N_OECD.primary 0.4, N_OECD.secondary 0.2/,
  22  *elasticity of demand
  23  e_d(r,al) /USA.primary -0.2, USA.secondary -0.5, EU.primary -0.2, EU.secondary -0.5, OECD.primary -0.2, OECD.secondary -0.5, N_OECD.primary -0.2, N_OECD.secondary -0.5/;
  24   
  25  *currently based off of Pd = a + b*Qd, Ps = c + d*Qs, where a,b,c,d are parameters
  26  parameter a(r,al),b(r,al),c(r,al),d(r,al);
  27   
  28  b(r,al) = pbar(r,al) / (e_d(r,al) * qbar_d(r,al));
  29  a(r,al) = pbar(r,al) - b(r,al) * qbar_d(r,al);
  30  d(r,al) = pbar(r,al) / (e_s(r,al) * qbar_s(r,al));
  31  c(r,al) = pbar(r,al) - d(r,al) * qbar_s(r,al);
  32   
  33  alias(r,rr);
  34  *t will essentially be the cost of transportation
  35  parameter t(r,rr,al);
  36   
  37   
  38  t(r,rr,al) = abs(pbar(rr,al) - pbar(r,al)) ;
  39   
  40   
  41  positive variable Qd(r,al), Qs(r,al);
  42   
  43  * variable X(r,al) "exports";
  44  variable W "total welfare";
  45   
  46  *market clearing conditions
  47  equation objfn;
  48   
  49   
  50   
  51  alias(r,rr) ;
  52  positive variable ship(r,rr,al) ;
  53  *no exports of secondary aluminum from EU to non-OECD
  54  ship.fx('EU', 'N_OECD', 'secondary') = 0;
  55   
  56  objfn.. W =e=
  57     sum((r,al), a(r,al) * Qd(r,al) + b(r,al) * Qd(r,al) *Qd(r,al) /2
  58     - c(r,al) * Qs(r,al) - d(r,al) *Qs(r,al) * Qs(r,al) / 2 )
  59     - sum((r,rr,al), t(r,rr,al) * ship(r,rr,al));
  60   
  61  equation market_clearing_r(r,al) ;
  62  market_clearing_r(r,al)..  Qd(r,al) + sum(rr$(not sameas(r,rr)), ship(r,rr,al)) =e= Qs(r,al) + sum(rr$(not sameas(r,rr)), ship(rr,r,al));
  63   
  64  model simple /all/;
  65   
  66  solve simple using QCP maximizing W;
  67   
  68  *$exit
  69   
  70  parameter rep;
  71   
  72  rep("EU secondary ban to non-oecd", "Qd", r, al) = Qd.l(r,al);
  73  rep("EU secondary ban to non-oecd", "Qs", r, al) = Qs.l(r,al);
  74  rep("EU secondary ban to non-oecd", "P", r, al) = market_clearing_r.m(r,al);
  75   
  76  execute_unload "eu_export_ban.gdx" ;
  77   
  78   


