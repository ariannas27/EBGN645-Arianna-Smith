C o m p i l a t i o n


   1   
   2  *current sets: regions (US, EU, OECD (-EU countries in OECD and US), Non-OECD(essentially row now?)), aluminum type (primary or secondary)
   3  **may further complicate the regions set, Certainly add canada next (next situation is US Tariffs)
   4  *will have to add time dimension, this is another set?
   5  *****NEXT STEPS: FIND ACCURATE DATA, EU EXPORT BAN, ADD CANADA, US TARIFFS******
   6   
   7  set r /USA, EU, OECD, N_OECD/;
   8  set al /primary, secondary/;
   9   
  10  *parameters = essentially cost curves, !!!!!!!!FIND BETTER NUMBERS!!!!! - currently using rough estimated numbers from AI
  11  *prices USD/metric ton , qty = metric tons , currently total aluminum (primary + secondary)
  12  parameter
  13  ****NUMBERS ARE PRETTY RANDOM NEED TO SEARCH FOR BETTER DATA**************
  14  *!!!!!!!!!!!!!!!!Prices for Importers need to be higher than the respective exporters!!!!!!!!!!!!!!!!
  15  pbar(r,al) /USA.primary 5500, USA.secondary 3100, EU.primary 3700, EU.secondary 3300, OECD.primary 3550, OECD.secondary 3100, N_OECD.primary 3150, N_OECD.secondary 3500/,
  16  *qty supplied aluminum USA and ROW
  17  qbar_s(r,al) /USA.primary 700000, USA.secondary 5000000, EU.primary 3000000, EU.secondary 6900000, OECD.primary 7300000, OECD.secondary 5300000, N_OECD.primary 62000000, N_OECD.secondary 12800000/,
  18  *qty demanded aluminum USA and ROW
  19  qbar_d(r,al) /USA.primary 3500000, USA.secondary 3300000, EU.primary 7500000, EU.secondary 6200000, OECD.primary 4500000, OECD.secondary 4500000, N_OECD.primary 57500000, N_OECD.secondary 16000000/,
  20  **!!!!!change for at least primary and secondary for now!!!!
  21  *elasticity of supply
  22  e_s(r,al) /USA.primary 0.4, USA.secondary 0.4, EU.primary 0.4, EU.secondary 0.4, OECD.primary 0.4, OECD.secondary 0.4, N_OECD.primary 0.4, N_OECD.secondary 0.4/,
  23  *elasticity of demand
  24  e_d(r,al) /USA.primary -0.4, USA.secondary -0.4, EU.primary -0.4, EU.secondary -0.4, OECD.primary -0.4, OECD.secondary -0.4, N_OECD.primary -0.4, N_OECD.secondary -0.4/;
  25   
  26  *currently based off of Pd = a + b*Qd, Ps = c + d*Qs, where a,b,c,d are parameters
  27  parameter a(r,al),b(r,al),c(r,al),d(r,al);
  28   
  29  b(r,al) = pbar(r,al) / (e_d(r,al) * qbar_d(r,al));
  30  a(r,al) = pbar(r,al) - b(r,al) * qbar_d(r,al);
  31  d(r,al) = pbar(r,al) / (e_s(r,al) * qbar_s(r,al));
  32  c(r,al) = pbar(r,al) - d(r,al) * qbar_s(r,al);
  33   
  34  alias(r,rr);
  35  *t will essentially be the cost of transportation
  36  parameter t(r,rr,al);
  37  *transport of primary from OECD to USA
  38  *t("OECD", "primary") = pbar("USA", "primary") - pbar("OECD", "primary");
  39  *transport of primary from non-oecd to EU
  40  *t("N_OECD", "primary") = pbar("EU", "primary") - pbar("N_OECD", "primary");
  41  *transport of secondary from US to non OECD
  42  *t("USA", "secondary") = pbar("N_OECD", "secondary") - pbar("USA", "secondary");
  43  *transport of secondary from EU to non-OECD
  44  *t("EU", "secondary") = pbar("N_OECD", "secondary") - pbar("EU", "secondary");
  45  *transport of secondary from OECD to non-OECD
  46  *t("OECD", "secondary") = pbar("N_OECD", "secondary") - pbar("OECD", "secondary");
  47   
  48  t(r,rr,al) = abs(pbar(rr,al) - pbar(r,al)) ;
  49   
  50  *varibales - will have to have more specefic to primary and secondary
  51  positive variable Qd(r,al), Qs(r,al);
  52  **!!!!needs to be for region too!!!!
  53  * variable X(r,al) "exports";
  54  variable W "total welfare";
  55   
  56  *market clearing conditions
  57  equation objfn;
  58  *, market_clearing_USA, market_clearing_EU, market_clearing_OECD, market_clearing_N_OECD;
  59   
  60   
  61  ** market clearning for each region: OECD exports primary to US, Non-OECD exports primary to EU, US EU and OECD export secondary to non-oecd
  62  *US imports primary, export secondary
  63  *market_clearing_USA(al).. Qd('USA',al) + X('USA',al)$sameas(al,"secondary") =e= Qs('USA',al) + X('USA',al)$sameas(al,"primary");
  64  **EU imports primary, exports secondary
  65  *market_clearing_EU(al).. Qd('EU',al) + X('EU',al)$sameas(al,"secondary") =e= Qs('EU',al) + X('EU',al)$sameas(al,"primary");
  66  *OECD exports primary and secondary
  67  *market_clearing_OECD(al).. Qd('OECD',al) + X('OECD',al) =e= Qs('OECD',al);
  68  *non oecd exports primary and imports secondary
  69  *market_clearing_N_OECD(al).. Qd('N_OECD',al) + X('N_OECD',al)$sameas(al,"primary") =e= Qs('N_OECD',al) + X('N_OECD',al)$sameas(al,"secondary");
  70   
  71   
  72  alias(r,rr) ;
  73  positive variable ship(r,rr,al) ;
  74   
  75   
  76  objfn.. W =e=
  77     sum((r,al), a(r,al) * Qd(r,al) + b(r,al) * Qd(r,al) *Qd(r,al) /2
  78     - c(r,al) * Qs(r,al) - d(r,al) *Qs(r,al) * Qs(r,al) / 2 )
  79     - sum((r,rr,al), t(r,rr,al) * ship(r,rr,al));
  80   
  81  equation market_clearing_r(r,al) ;
  82  market_clearing_r(r,al)..  Qd(r,al) + sum(rr$(not sameas(r,rr)), ship(r,rr,al)) =e= Qs(r,al) + sum(rr$(not sameas(r,rr)), ship(rr,r,al));
  83   
  84  model simple /all/;
  85   
  86  solve simple using QCP maximizing W;
  87   
  88  *$exit
  89   
  90  parameter rep;
  91   
  92  rep("BAU", "Qd", r, al) = Qd.l(r,al);
  93  rep("BAU", "Qs", r, al) = Qs.l(r,al);
  94  rep("BAU", "P", r, al) = market_clearing_r.m(r,al);
  95   
  96  execute_unload "simple.gdx" ;
  97   
  98   


